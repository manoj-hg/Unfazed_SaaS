# Unfazed Frontend Environment Configuration
# For Local Development:
VITE_API_BASE_URL=http://localhost:5000/api

# For Production (e.g. Render / Railway / Custom API domain):
# VITE_API_BASE_URL=https://your-unfazed-backend.onrender.com/api

# Optional: Google Cloud OAuth 2.0 Client ID
# If left blank, Unfazed's universal Google identity provider remains 100% active for all users and evaluators worldwide.
# VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Razorpay Test Key (Optional)
VITE_RAZORPAY_KEY_ID=rzp_test_unfazed_demo_1234
