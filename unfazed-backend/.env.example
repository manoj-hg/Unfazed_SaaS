# Unfazed Backend Production Environment Configuration
PORT=5000

# MongoDB Connection String:
# For Local: mongodb://127.0.0.1:27017/unfazed
# For Cloud Atlas: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/unfazed?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/unfazed

# JWT Authentication Secret
JWT_SECRET=unfazed_jwt_production_secret_key_2026_secure

# Frontend Origin for CORS & Socket.io (e.g., https://your-unfazed.vercel.app or localhost)
CLIENT_URL=http://localhost:5173

# Razorpay Test Credentials (Optional)
RAZORPAY_KEY_ID=rzp_test_unfazed_demo_1234
RAZORPAY_KEY_SECRET=secret_test_unfazed_demo_5678

# Email Service (Optional for transactional dispatch)
EMAIL_USER=
EMAIL_PASS=

# Optional Google OAuth Client ID
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
